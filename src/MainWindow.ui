  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #f8f9fa;
}
QGroupBox {
    font-weight: bold;
    border: 2px solid #dee2e6;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
    color: #495057;
}
QPushButton {
    padding: 10px 20px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 500;
    min-height: 40px;
}
QPushButton:hover {
    opacity: 0.9;
}
QPushButton:pressed {
    opacity: 0.8;
}
QPushButton:disabled {
    background-color: #adb5bd;
    color: #6c757d;
}
QComboBox, QLineEdit {
    padding: 8px 12px;
    border: 2px solid #dee2e6;
    border-radius: 6px;
    background-color: white;
    font-size: 13px;
}
QComboBox:hover, QLineEdit:hover {
    border-color: #adb5bd;
}
QComboBox:focus, QLineEdit:focus {
    border-color: #228be6;
}
QRadioButton, QCheckBox {
    font-size: 13px;
    spacing: 8px;
}
QProgressBar {
    border: 2px solid #dee2e6;
    border-radius: 6px;
    text-align: center;
    height: 20px;
    background-color: #f1f3f5;
}
QProgressBar::chunk {
    background-color: #40c057;
    border-radius: 4px;
}
</string>
